# Server-side Postgres connection used by Drizzle.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electric_sync

# Direct Postgres connection consumed by the local Electric service.
ELECTRIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electric_sync

# Optional settings for a hosted Electric service.
ELECTRIC_URL=http://localhost:30000
ELECTRIC_SOURCE_ID=
ELECTRIC_SECRET=
